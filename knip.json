{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/lib/lazy/hidden-power.ts": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/workers/eval-worker.ts",
        "scripts/*.mjs",
        "test/ui/fixtures/*.ts"
      ],
      "playwright": {
        "config": ["playwright.config.ts", "playwright.*.config.ts"]
      }
    },
    "packages/*": {
      "entry": [
        "test/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  }
}
