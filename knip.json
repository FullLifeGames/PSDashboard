{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".remember/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/workers/eval-worker.ts",
        "scripts/*.mjs",
        "ui/fixtures/*.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "test/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  }
}
