{
  "name": "ps-dashboard",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "knip": "knip",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "test:build": "playwright test -c playwright.build.config.ts",
    "test:feedback": "playwright test -c playwright.feedback.config.ts",
    "test:regression": "playwright test -c playwright.regression.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fulllifegames/eval-engine": "*",
    "@fulllifegames/replay-core": "*",
    "@pkmn/client": "^0.7.3",
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@pkmn/sim": "^0.10.11",
    "@pkmn/smogon": "^0.6.0",
    "@smogon/calc": "^0.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "knip": "^6.34.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
