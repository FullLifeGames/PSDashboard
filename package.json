{
  "name": "ps-dashboard",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:packages": "tsc -b packages/replay-core packages/eval-engine",
    "lint": "eslint . && node scripts/twin-lists.mjs",
    "knip": "knip",
    "pack:smoke": "node ./scripts/pack-smoke.mjs",
    "upgrade:pkmn": "node ./scripts/upgrade-pkmn.mjs",
    "publish:packages": "node ./scripts/publish-packages.mjs",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "test:build": "playwright test -c playwright.build.config.ts",
    "test:feedback": "node ./scripts/run-e2e.mjs --dev-port 5176 -c playwright.feedback.config.ts",
    "test:regression": "vitest run",
    "test:ui": "vitest run --project ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fulllifegames/eval-engine": "*",
    "@fulllifegames/replay-core": "*",
    "@pkmn/client": "^0.7.4",
    "@pkmn/data": "^0.10.12",
    "@pkmn/dex": "^0.10.12",
    "@pkmn/mods": "0.10.12",
    "@pkmn/protocol": "0.7.4",
    "@pkmn/sim": "0.10.12",
    "@pkmn/smogon": "^0.6.1",
    "@smogon/calc": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "knip": "^6.43.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
