{
  "name": "@fulllifegames/eval-engine",
  "version": "1.0.1",
  "description": "Position evaluation for Pokémon Showdown replays: reconstruction, search, per-turn analysis, and the game report.",
  "keywords": [
    "pokemon",
    "pokemon-showdown",
    "replay",
    "evaluation",
    "search",
    "analysis",
    "mcts"
  ],
  "homepage": "https://github.com/FullLifeGames/PSDashboard/tree/master/packages/eval-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FullLifeGames/PSDashboard.git",
    "directory": "packages/eval-engine"
  },
  "bugs": {
    "url": "https://github.com/FullLifeGames/PSDashboard/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "eval-engine": "bin/eval-engine.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "samples",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run --root ../.. --config vitest.config.ts --project eval-engine"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fulllifegames/replay-core": "*"
  },
  "peerDependencies": {
    "@pkmn/dex": "^0.10.12",
    "@pkmn/mods": "0.10.12",
    "@pkmn/sim": "0.10.12",
    "@smogon/calc": "^0.12.0"
  }
}
